      hydra.run.dir="${RUN_DIR}"
  )

  if [[ "${DRY_RUN:-0}" == "1" ]]; then
      printf '%q ' env CUDA_VISIBLE_DEVICES="${GPU_IDS}" "${ACCELERATE_BIN}" launch "${launch_args[@]}"
      printf '\n'
      exit 0
  fi

